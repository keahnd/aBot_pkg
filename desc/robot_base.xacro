<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:include filename='materials.xacro'></xacro:include>
    <xacro:include filename='moi_macros.xacro'></xacro:include>

    <link name='base_link'>
    </link>

    <joint name='chassis_joint' type='fixed'>
        <parent link='base_link'/>
        <child link='chassis'/>
        <origin xyz='0.02 0 0.014'/>
    </joint>

    <link name='chassis'>
        <visual>
            <origin xyz='0 0 0'/>
            <geometry>
                <box size='0.18 0.18 0.068'/>
            </geometry>
            <material name='purple'/>
        </visual>
        <collision>
            <origin xyz='0 0 0'/>
            <geometry>
                <box size='0.18 0.18 0.068'/>
            </geometry>
        </collision>
        <xacro:cuboid_moi mass='1.0635' l='0.18' b='0.18' h='0.068'>
            <origin xyz='0 0 0' rpy='0 0 0'/>
        </xacro:cuboid_moi>
    </link>

    <joint name='left_wheel_joint' type='continuous'>
        <parent link='base_link'/>
        <child link='left_wheel'/>
        <origin xyz='0 0.09 0' rpy='-${pi/2} 0 0'/>
        <axis xyz='0 0 1'/>
    </joint>

    <link name='left_wheel'>
        <visual>
            <origin xyz='0 0 0.0135'/>
            <geometry>
                <cylinder radius='0.033' length='0.027'/>
            </geometry>
            <material name='blue'/>
        </visual>
        <collision>
			<origin xyz='0 0 0.0135'/>
            <geometry>
                <cylinder radius='0.033' length='0.027'/>
            </geometry>
        </collision>
        <xacro:cylinder_moi mass='0.033' r='0.033' l='0.027'>
            <origin xyz='0 0 0.0135' rpy='0 0 0'/>
        </xacro:cylinder_moi>
    </link>

    <joint name='right_wheel_joint' type='continuous'>
        <parent link='base_link'/>
        <child link='right_wheel'/>
        <origin xyz='0 -0.09 0' rpy='${pi/2} 0 0'/>
        <axis xyz='0 0 -1'/>
    </joint>

    <link name='right_wheel'>
        <visual>
            <origin xyz='0 0 0.0135'/>
            <geometry>
                <cylinder radius='0.033' length='0.027'/>
            </geometry>
            <material name='blue'/>
        </visual>
        <collision>
			<origin xyz='0 0 0.0135'/>
            <geometry>
                <cylinder radius='0.033' length='0.027'/>
            </geometry>
        </collision>
        <xacro:cylinder_moi mass='0.033' r='0.033' l='0.027'>
            <origin xyz='0 0 0.0135' rpy='0 0 0'/>
        </xacro:cylinder_moi>
    </link>

    <joint name='caster_wheel_joint' type='fixed'>
        <parent link='base_link'/>
        <child link='caster_wheel'/>
        <origin xyz='0.085 0 -0.02'/>
    </joint>

    <link name='caster_wheel'>
        <visual>
            <origin xyz='0 0 0'/>
            <geometry>
                <sphere radius='0.0085'/>
            </geometry>
            <material name='blue'/>
        </visual>
        <collision>
            <geometry>
                <sphere radius='0.0085'/>
            </geometry>
        </collision>
        <xacro:sphere_moi mass='0.043' r='0.0085'>
            <origin xyz='0 0 0' rpy='0 0 0'/>
        </xacro:sphere_moi>
    </link>

    <gazebo reference='caster_wheel'>
        <mu1 value='0.000001'/>
        <mu2 value='0.000001'/>
    </gazebo>

</robot>